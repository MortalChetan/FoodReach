# ==========================================
# FoodReach Production Environment Variables
# ==========================================

# Server Port
PORT=8080

# MongoDB URI (e.g., local container or MongoDB Atlas Cloud URI)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/foodreach_db
# Or MongoDB Atlas:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodreach_db?retryWrites=true&w=majority

# JWT Security Signature (256-bit Hex Key)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Web Domains
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://foodreach.org
